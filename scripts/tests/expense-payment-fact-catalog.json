      "constraints": [
        {
          "name": "expense_creator_payment_fact_contract",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((creator_payment_fact IS NULL) OR ((origin = 'company_purchase'::text) AND (creator_payment_fact = ANY (ARRAY['unpaid'::text, 'company_paid'::text, 'personal_paid'::text, 'unknown'::text])))))",
          "initially_deferred": false
        },
        {
          "name": "expense_integrity",
          "type": "t",
          "validated": true,
          "deferrable": true,
          "definition": "TRIGGER DEFERRABLE INITIALLY DEFERRED",
          "initially_deferred": true
        },
        {
          "name": "finance_expenses_advisory_matter_id_fkey",
          "type": "f",
          "validated": true,
          "deferrable": false,
          "definition": "FOREIGN KEY (advisory_matter_id) REFERENCES advisory_matters(id)",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_case_id_fkey",
          "type": "f",
          "validated": true,
          "deferrable": false,
          "definition": "FOREIGN KEY (case_id) REFERENCES cases(id)",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_category_check",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((length(btrim(category)) >= 1) AND (length(btrim(category)) <= 150)))",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_check",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((reimbursement_requested >= (0)::numeric) AND (reimbursement_requested <= gross_amount)))",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_check1",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((origin = 'legacy_claim'::text) = (legacy_claim_id IS NOT NULL)))",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_check2",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((origin <> 'employee_claim'::text) OR (claimant_id = created_by)))",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_check3",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((NOT personally_paid) OR (claimant_id IS NOT NULL)))",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_check4",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK ((personally_paid OR (reimbursement_requested = (0)::numeric)))",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_check5",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((case_id IS NULL) OR (advisory_matter_id IS NULL)))",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_check6",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((status = 'draft'::text) OR (submitted_at IS NOT NULL)))",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_check7",
          "type": "c",
          "validated": true,
          "deferrable": false,
          "definition": "CHECK (((status = ANY (ARRAY['accepted'::text, 'rejected'::text])) = ((reviewed_at IS NOT NULL) AND (reviewed_by IS NOT NULL) AND (NULLIF(btrim(review_reason), ''::text) IS NOT NULL))))",
          "initially_deferred": false
        },
        {
          "name": "finance_expenses_claimant_id_fkey",
          "type": "f",
          "validated": true,
          "deferrable": false,
          "definition": "FOREIGN KEY (claimant_id) REFERENCES user_profiles(id)",
          "initially_deferred": false
        },
